{
  "name": "@pathlyhq/pulumi",
  "version": "0.1.0",
  "description": "Pulumi provider for the Pathly monitoring API (HTTP scenarios, webhooks, maintenance windows, SLA targets)",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib coverage",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "files": [
    "lib",
    "README.md",
    "README.fr.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "homepage": "https://pathlyhq.com",
  "bugs": {
    "url": "https://github.com/pathlyhq/pathly-pulumi/issues"
  },
  "keywords": [
    "pathly",
    "pathlyhq",
    "monitoring",
    "synthetic-monitoring",
    "saas",
    "pulumi",
    "synthetic",
    "sla"
  ],
  "author": {
    "name": "Simon Raynaud / keyral"
  },
  "contributors": [
    "Pathly <devs@pathlyhq.com>"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pathlyhq/pathly-pulumi.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@pulumi/pulumi": "^3.140.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
